# Шаблон .env для сервера. Скопируй на сервер, заполни и запускай docker-compose.

# Образ из реестра (обязательно заполни)
IMAGE_NAME=ghcr.io/владелец/репозиторий:latest

# Приложение
HOST=0.0.0.0
PORT=8000
DEBUG=False
RELOAD=False

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=задай-надёжный-пароль
POSTGRES_DB=todolist
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT (обязательно смени SECRET_KEY на свой случайный ключ)
SECRET_KEY=смени-на-длинный-случайный-ключ
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
